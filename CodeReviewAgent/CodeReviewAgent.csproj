<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.AI" Version="9.5.0" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Templates\default-comment-template.html" />
      <EmbeddedResource Include="Templates\default-comment-template.html">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </EmbeddedResource>
      <None Remove="Templates\default-review-rules.txt" />
      <EmbeddedResource Include="Templates\default-review-rules.txt">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </EmbeddedResource>
      <None Remove="Templates\system-prompt.txt" />
      <Content Include="Templates\system-prompt.txt">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <None Remove="Templates\tools-description.txt" />
      <Content Include="Templates\tools-description.txt">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <None Remove="Templates\additional-instructions.txt" />
      <Content Include="Templates\additional-instructions.txt">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <None Remove="Templates\response-pattern.txt" />
      <Content Include="Templates\response-pattern.txt">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
